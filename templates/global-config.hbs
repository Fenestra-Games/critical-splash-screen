<div class="css-pane">
  <p class="css-note">{{localize "CSS.Global.Intro"}}</p>

  <section class="css-section">
    <h3>{{localize "CSS.Global.Display"}}</h3>
    <div class="css-row">
      <span class="css-row-label">{{localize "CSS.Global.Scale"}}</span>
      <small>{{localize "CSS.Global.ScaleHint"}}</small>
      <input type="number" name="scale" value="{{scale}}" step="0.05" min="0.05" max="3">
    </div>
    <div class="css-row">
      <span class="css-row-label">{{localize "CSS.Global.DefaultCrit"}}</span>
      <small>{{localize "CSS.Global.DefaultHint"}}</small>
      <div class="form-fields">
        <input type="text" name="defaultCrit" value="{{defaultCrit}}">
        <button type="button" data-action="pickImage" data-target="defaultCrit"><i class="fas fa-file-import"></i></button>
      </div>
    </div>
    <div class="css-row">
      <span class="css-row-label">{{localize "CSS.Global.DefaultFumble"}}</span>
      <small>{{localize "CSS.Global.DefaultHint"}}</small>
      <div class="form-fields">
        <input type="text" name="defaultFumble" value="{{defaultFumble}}">
        <button type="button" data-action="pickImage" data-target="defaultFumble"><i class="fas fa-file-import"></i></button>
      </div>
    </div>
  </section>

  <section class="css-section">
    <h3>{{localize "CSS.Global.SoundFolders"}}</h3>
    <div class="css-row">
      <span class="css-row-label">{{localize "CSS.Global.DeathFolder"}}</span>
      <small>{{localize "CSS.Global.DeathFolderHint"}}</small>
      <div class="form-fields">
        <input type="text" name="deathSoundFolder" value="{{deathSoundFolder}}">
        <button type="button" data-action="pickImage" data-target="deathSoundFolder" data-picker-type="folder"><i class="fas fa-folder-open"></i></button>
      </div>
    </div>
    <div class="css-row">
      <span class="css-row-label">{{localize "CSS.Global.CritFolder"}}</span>
      <small>{{localize "CSS.Global.CritFolderHint"}}</small>
      <div class="form-fields">
        <input type="text" name="critSoundFolder" value="{{critSoundFolder}}">
        <button type="button" data-action="pickImage" data-target="critSoundFolder" data-picker-type="folder"><i class="fas fa-folder-open"></i></button>
      </div>
    </div>
    <div class="css-row">
      <span class="css-row-label">{{localize "CSS.Global.FumbleFolder"}}</span>
      <small>{{localize "CSS.Global.FumbleFolderHint"}}</small>
      <div class="form-fields">
        <input type="text" name="fumbleSoundFolder" value="{{fumbleSoundFolder}}">
        <button type="button" data-action="pickImage" data-target="fumbleSoundFolder" data-picker-type="folder"><i class="fas fa-folder-open"></i></button>
      </div>
    </div>
  </section>

  <footer class="css-buttons">
    <button type="submit"><i class="fas fa-save"></i> {{localize "CSS.Save"}}</button>
  </footer>
</div>
